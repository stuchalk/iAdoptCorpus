@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix ex: <http://example.org/iadopt/> .

ex:SulfateAerosol
    a iop:Variable ;
    rdfs:label "Organic sulfate/nitrate in aerosol particles" ;
    skos:definition "Number fraction of aerosol particles from 0.1 um to larger than 1 um that are identified as sulfate-organic-nitrate internal mixtures." ;
    rdfs:comment "Number fraction -> ratio; aerosol; particle; size:0.1 um to larger than 1 um ; sulfate-organic-nitrate internal mixture; ADD: particle mixture; quantity: total." ;
    skos:related "https://github.com/mabablue/I-ADOPT-examples-playground/issues/101" ;
    iop:hasObjectOfInterest iop:AsymmetricSystem ;
    iop:hasMatrix <https://www.wikidata.org/entity/Q104541> ;
    iop:hasProperty <https://www.wikidata.org/entity/Q3481047> ;
    iop:hasConstraint 
        [ a iop:Constraint ;
            rdfs:isDefinedBy "composition" ;
            rdfs:label "organosulfate or organonitrate" ;
            iop:constrains <https://www.wikidata.org/entity/Q1621273> ;
        ] ,
        [ a iop:Constraint ;
            rdfs:isDefinedBy "statistic" ;
            rdfs:label "total" ;
            iop:constrains <https://www.wikidata.org/entity/Q1621273> ;
        ] ,
        [ a iop:Constraint ;
            rdfs:isDefinedBy "condition" ;
            rdfs:label "diameter: 0.1 - 1 µm" ;
            iop:constrains <https://www.wikidata.org/entity/Q1621273> ;
        ] .

iop:AsymmetricSystem
    a iop:Entity ;
    iop:hasNumerator <https://www.wikidata.org/entity/Q1621273> ;
    iop:hasDenominator <https://www.wikidata.org/entity/Q1621273> ; .

<https://www.wikidata.org/entity/Q104541>
    a iop:Entity ;
    rdfs:label "aerosol" .

<https://www.wikidata.org/entity/Q3481047>
    a iop:Property ;
    rdfs:label "particle number fraction" .

<https://www.wikidata.org/entity/Q1621273>
    a iop:Entity ;
    rdfs:label "particle" .

<https://www.wikidata.org/entity/Q1621273>
    a iop:Entity ;
    rdfs:label "particle" .
