ex::TBPHMilk
    a iop:Variable ;
    rdfs:label "Mass concentration of tbph in breast milk" ;
    skos:definition "Mass concentration of tbph in breast milk";
    rdfs:comment "breast milk, bis(2-ethylhexyl) tetrabromophthalate, mass concentration, person" ;
    skos:related "https://github.com/mabablue/I-ADOPT-examples-playground/issues/127";
    iop:hasObjectOfInterest iop:AsymmetricSystem ;
    iop:hasMatrix <https://www.wikidata.org/entity/Q5> ;
    iop:hasProperty <https://www.wikidata.org/entity/Q589446> .

iop:AsymmetricSystem
    a iop:Entity ;
    iop:hasNumerator <https://www.wikidata.org/entity/Q19931407> ;
    iop:hasDenominator <https://www.wikidata.org/entity/Q22728> .

<https://www.wikidata.org/entity/Q5>
    a iop:Entity ;
    rdfs:label "person" .

<https://www.wikidata.org/entity/Q589446>
    a iop:Property ;
    rdfs:label "mass concentration" .

<https://www.wikidata.org/entity/Q19931407>
    a iop:Entity ;
