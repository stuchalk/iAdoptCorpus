@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix ex: <http://example.org/iadopt/> .

ex:weight
    a iop:Variable ;
    rdfs:label "Weight without clothes" ;
    skos:definition "current weight in kilogram without clothes; in case of pregnancy: last weight before pregnancy" ;
    rdfs:comment "current weight in kilogram without clothes; in case of pregnancy: last weight before pregnancy" ;
    skos:related "https://github.com/mabablue/I-ADOPT-examples-playground/issues/114" ;
    iop:hasObjectOfInterest <https://www.wikidata.org/entity/Q215627> ;
    iop:hasProperty <https://www.wikidata.org/entity/Q11423> ;
    iop:hasConstraint 
        [ a iop:Constraint ;
            rdfs:isDefinedBy "criteria" ;
            rdfs:label "latest" ;
            iop:constrains <https://www.wikidata.org/wiki/Q18189> ;
        ],
        [ a iop:Constraint ;
            rdfs:isDefinedBy "status" ;
            rdfs:label "naked" ;
            iop:constrains <https://www.wikidata.org/entity/Q215627> ;
        ] ,
        [ a iop:Constraint ;
            rdfs:isDefinedBy "status" ;
            rdfs:label "not pregnant" ;
            iop:constrains <https://www.wikidata.org/entity/Q215627> ;
        ] .

<https://www.wikidata.org/entity/Q215627>
    a iop:Entity ;
    rdfs:label "person" .

<https://www.wikidata.org/entity/Q11423>
    a iop:Property ;
    rdfs:label "mass" .
