@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix ex: <http://example.org/iadopt/> .

ex:highesteducation
    a iop:Variable ;
    rdfs:label "Level of highest education" ;
    rdfs:comment "level of highest education" ;
    iop:hasObjectOfInterest <https://www.wikidata.org/entity/Q5> ;
    iop:hasProperty <https://www.wikidata.org/wiki/Q18189> ;
    iop:hasConstraint 
        [ a iop:Constraint ;
            rdfs:isDefinedBy "criteria" ;
            rdfs:label "highest" ;
            iop:constrains <https://www.wikidata.org/wiki/Q18189> ;
        ],
        [ a iop:Constraint ;
            rdfs:isDefinedBy "role" ;
            rdfs:label "patient" ;
            iop:constrains <https://www.wikidata.org/entity/Q5> ;
        ].

<https://www.wikidata.org/entity/Q5>
    a iop:Entity ;
    rdfs:label "person" .

<https://www.wikidata.org/wiki/Q18189>
    a iop:Property ;
    rdfs:label "educational stage" .
