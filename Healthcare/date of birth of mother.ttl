@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix ex: <http://example.org/iadopt/> .

ex:birthdatemother
    a iop:Variable ;
    rdfs:label "Date of birth of mother" ;
    rdfs:comment "date of birth of mother" ;
    skos:related "https://github.com/mabablue/I-ADOPT-examples-playground/issues/113" ;
    iop:hasObjectOfInterest <https://www.wikidata.org/entity/Q14819852> ;
    iop:hasMatrix <https://www.wikidata.org/entity/Q215627> ;
    iop:hasProperty <https://www.wikidata.org/entity/Q205892> ;
    iop:hasConstraint 
        [ a iop:Constraint ;
            rdfs:isDefinedBy "relationship" ;
            rdfs:label "mother of interviewed person" ;
            iop:constrains <https://www.wikidata.org/entity/Q215627> ;
        ] .

<https://www.wikidata.org/entity/Q14819852>
    a iop:Entity ;
    rdfs:label "birth" .

<https://www.wikidata.org/entity/Q215627>
    a iop:Entity ;
    rdfs:label "person" .

<https://www.wikidata.org/entity/Q205892>
    a iop:Property ;
    rdfs:label "calendar date" .
