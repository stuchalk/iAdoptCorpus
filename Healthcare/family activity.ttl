<http://example.org/iadopt/healthcare/familyactivity>
    a 
        iop:Variable ;
    rdfs:label 
        "Number of Hours of family activity per week" ;
    rdfs:comment 
        """Number of Hours of family activity per week""" ;
    iop:hasObjectOfInterest 
        <https://www.wikidata.org/entity/Q61788146> ;
    iop:hasMatrix 
        <https://www.wikidata.org/entity/Q5> ;
    iop:hasStatisticalModifier 
        <https://www.wikidata.org/entity/Q2796622> ;
    iop:hasProperty 
        <https://www.wikidata.org/entity/Q11471> ;
    iop:hasConstraint 
        [ a iop:Constraint ;
             rdfs:label "normalization: week" ;
             iop:constrains <https://www.wikidata.org/entity/Q11471> ;
        ] .

