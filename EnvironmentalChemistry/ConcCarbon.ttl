@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix ex: <http://example.org/iadopt/> .

ex:ConcCarbon
    a iop:Variable ;
    rdfs:label "Concentration of dissolved organic carbon in water" ;
    rdfs:comment "Mass concentration of dissolved organic carbon in water" ;
    skos:related "https://github.com/mabablue/I-ADOPT-examples-playground/issues/119" ;
    iop:hasObjectOfInterest iop:AsymmetricSystem ;
    iop:hasProperty <https://www.wikidata.org/entity/Q589446> ;
    iop:hasConstraint 
        [ a iop:Constraint ;
            rdfs:isDefinedBy "state" ;
            rdfs:label "dissolved" ;
            iop:constrains <https://www.wikidata.org/entity/Q623> ;
        ] ,
        [ a iop:Constraint ;
            rdfs:isDefinedBy "class" ;
            rdfs:label "organic" ;
            iop:constrains <https://www.wikidata.org/entity/Q623> ;
        ] .

iop:AsymmetricSystem
    a iop:Entity ;
    iop:hasNumerator <https://www.wikidata.org/entity/Q623> ;
    iop:hasDenominator <https://www.wikidata.org/entity/Q283> .

<https://www.wikidata.org/entity/Q589446>
    a iop:Property ;
    rdfs:label "mass concentration" .

<https://www.wikidata.org/entity/Q623>
    a iop:Entity ;
    rdfs:label "carbon" .

<https://www.wikidata.org/entity/Q283>
    a iop:Entity ;
    rdfs:label "water" .
