@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix ex: <http://example.org/iadopt/> .

ex:GDOP
    a iop:Variable ;
    rdfs:label "GDOP Geometric dilution of precision " ;
    skos:definition "Geometric dilution of precision of the relative position, based on the position of the receiver and the transmitters." ;
    rdfs:comment "Geometric dilution of precision of the relative position, based on the position of the receiver and the transmitters." ;
    skos:related "https://github.com/mabablue/I-ADOPT-examples-playground/issues/44" ;
    iop:hasObjectOfInterest iop:SymmetricSystem ;
    iop:hasProperty <https://www.wikidata.org/entity/Q616896> ;
    iop:hasConstraint
        [ a iop:Constraint ;
            rdfs:isDefinedBy "position" ;
            rdfs:label "relative" ;
            iop:constrains <https://qudt.org/vocab/quantitykind/LinearVelocity> ;
        ] .

iop:SymmetricSystem
    a iop:Entity ;
    iop:hasPart 
        <https://www.wikidata.org/wiki/Q190157> ,
        <https://www.wikidata.org/wiki/Q159391> .

<https://www.wikidata.org/entity/Q616896>
    a iop:Property ;
    rdfs:label "dilution of precision" .

<https://www.wikidata.org/wiki/Q159391>
    a iop:Entity ;
    rdfs:label "receiver" .

<https://www.wikidata.org/wiki/Q190157>
    a iop:Entity ;
    rdfs:label "transmitter" .
