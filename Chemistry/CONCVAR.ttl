@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix ex: <http://example.org/iadopt/> .

ex:someVar
    a iop:Variable ;
    rdfs:label "Determination of the iron concentration in a soil sample" ;
    rdfs:comment "Determination of the iron concentration in a soil sample by colorimetric analysis using ortho-phenanthroline as mass fraction" ;
    rdfs:comment "SJC; the OOI should be iron not iron(II)" ;
    skos:related "https://github.com/mabablue/I-ADOPT-examples-playground/issues/80" ;
    iop:hasObjectOfInterest iop:AsymmetricSystem ;
    iop:hasProperty <https://www.wikidata.org/entity/Q899138> .

iop:AsymmetricSystem
    a iop:Entity ;
    iop:hasNumerator <https://www.wikidata.org/entity/Q428946> ;
    iop:hasDenominator <https://www.wikidata.org/entity/Q36133> .

<https://www.wikidata.org/entity/Q899138>
    a iop:Property ;
    rdfs:label "mass fraction" .

<https://www.wikidata.org/entity/Q428946>
    a iop:Entity ;
    rdfs:label "iron" .

<https://www.wikidata.org/entity/Q36133>
    a iop:Entity ;
    rdfs:label "soil" .
