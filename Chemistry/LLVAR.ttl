@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix ex: <http://example.org/iadopt/> .

ex:llvar
    a iop:Variable ;
    rdfs:label "solubility of benzene in water" ;
    skos:definition "solubility (g/L) of 99.82 % w/w pure benzene in deionized water at phase equilibrium and 298.15 K" ;
    rdfs:comment "solubility; 99.82 % w/w pure; benzene; deionized; water; 298.15 K, ADD: dissolved" ;
    skos:related "https://github.com/mabablue/I-ADOPT-examples-playground/issues/83" ;
    iop:hasObjectOfInterest iop:AsymmetricSystem ;
    iop:hasProperty <https://www.wikidata.org/entity/Q589446> ;
    iop:hasConstraint 
        [ a iop:Constraint ;
            rdfs:isDefinedBy "condition" ;
            rdfs:label "temperature of 298.15 K" ;
            iop:constrains <https://www.wikidata.org/entity/Q589446> ;
        ] ,
        [ a iop:Constraint ;
            rdfs:isDefinedBy "physical state" ;
            rdfs:label "dissolved" ;
            iop:constrains <https://www.wikidata.org/entity/Q2270> ;
        ] ,
        [ a iop:Constraint ;
            rdfs:isDefinedBy "quality" ;
            rdfs:label "dionized" ;
            iop:constrains <https://www.wikidata.org/entity/Q283> ;
        ] ,
        [ a iop:Constraint ;
            rdfs:isDefinedBy "quality" ;
            rdfs:label "purity of 99.82 % w/w" ;
            iop:constrains <https://www.wikidata.org/entity/Q2270> ;
        ] .

iop:AsymmetricSystem
    a iop:Entity ;
    iop:hasNumerator <https://www.wikidata.org/entity/Q2270> ;
    iop:hasDenominator <https://www.wikidata.org/entity/Q283> .

<https://www.wikidata.org/entity/Q589446>
    a iop:Property ;
    rdfs:label "mass concentration" .

<https://www.wikidata.org/entity/Q2270>
    a iop:Entity ;
    rdfs:label "benzene" .

<https://www.wikidata.org/entity/Q283>
    a iop:Entity ;
    rdfs:label "water" .
