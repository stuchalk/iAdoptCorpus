@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix ex: <http://example.org/iadopt/> .

ex:glvar
    a iop:Variable ;
    rdfs:label "solubility of molecular oxygen from air in water" ;
    rdfs:comment "solubility of molecular oxygen from air in water with MilliQ (18.2 MOhm) purity under local air conditions" ;
    skos:related "https://github.com/mabablue/I-ADOPT-examples-playground/issues/82" ;
    iop:hasObjectOfInterest iop:AsymmetricSystem ;
    iop:hasProperty <https://www.wikidata.org/entity/Q589446> ;
    iop:hasConstraint 
        [ a iop:Constraint ;
            rdfs:isDefinedBy "condition" ;
            rdfs:label "at room temperature" ;
            iop:constrains <https://www.wikidata.org/entity/Q589446> ;
        ] ,
        [ a iop:Constraint ;
            rdfs:isDefinedBy "condition" ;
            rdfs:label "at room pressure" ;
            iop:constrains <https://www.wikidata.org/entity/Q589446> ;
        ] ,
        [ a iop:Constraint ;
            rdfs:isDefinedBy "source" ;
            rdfs:label "air" ;
            iop:constrains <https://www.wikidata.org/entity/Q5203615> ;
        ] ,
        [ a iop:Constraint ;
            rdfs:isDefinedBy "quality" ;
            rdfs:label "conductivity of 18.2 MOhm" ;
            iop:constrains <https://www.wikidata.org/entity/Q283> ;
        ] .

iop:AsymmetricSystem
    a iop:Entity ;
    iop:hasDenominator <https://www.wikidata.org/entity/Q283> ;
    iop:hasNumerator <https://www.wikidata.org/entity/Q5203615> .

<https://www.wikidata.org/entity/Q589446>
    a iop:Property ;
    rdfs:label "mass concentration" .

<https://www.wikidata.org/entity/Q283>
    a iop:Entity ;
    rdfs:label "water" .

<https://www.wikidata.org/entity/Q5203615>
    a iop:Entity ;
    rdfs:label "molecular oxygen" .
