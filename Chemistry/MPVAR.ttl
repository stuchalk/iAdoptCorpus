@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix ex: <http://example.org/iadopt/> .

ex:mpvar
    a iop:Variable ;
    rdfs:label "melting point of naphthalene under standard conditions" ;
    skos:definition "thermodynamic temperature for the melting point (at the solid to liquid phase transition) of a known purity (99.12 % w/w) sample of naphthalene at atmospheric pressure" ;
    rdfs:comment "thermodynamic temperature; at the solid to liquid phase transition; purity (99.12 % w/w); naphthalene; at atmospheric pressure" ;
    skos:related "https://github.com/mabablue/I-ADOPT-examples-playground/issues/79" ;
    iop:hasObjectOfInterest <https://www.wikidata.org/entity/Q179724> ;
    iop:hasProperty <https://www.wikidata.org/entity/Q264647> ;
    iop:hasConstraint 
        [ a iop:Constraint ;
            rdfs:isDefinedBy "process" ;
            rdfs:label "solid to liquid phase transition" ;
            iop:constrains <https://www.wikidata.org/entity/Q264647> ;
        ] ,
        [ a iop:Constraint ;
            rdfs:isDefinedBy "quality" ;
            rdfs:label "purity of 99.12 % w/w" ;
            iop:constrains <https://www.wikidata.org/entity/Q179724> ;
        ] ,
        [ a iop:Constraint ;
            rdfs:isDefinedBy "condition" ;
            rdfs:label "pressure of 1 atm" ;
            iop:constrains <https://www.wikidata.org/entity/Q264647> ;
        ] .

<https://www.wikidata.org/entity/Q179724>
    a iop:Entity ;
    rdfs:label "naphthalene" .

<https://www.wikidata.org/entity/Q264647>
    a iop:Property ;
    rdfs:label "thermodynamic temperature" .
