@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix ex: <http://example.org/iadopt/> .

ex:FloodRiskMobility
    a iop:Variable ;
    rdfs:label "Flood risk index related to mobility and accessibility " ;
    rdfs:comment "Flood risk index related to mobility and accessibility when streets around the houses are flooded" ;
    rdfs:comment "SJC: separated out mobility and accessibility**" ;
    skos:related "https://github.com/mabablue/I-ADOPT-examples-playground/issues/98" ;
    iop:hasObjectOfInterest <https://www.wikidata.org/entity/Q2288778> ;
    iop:hasMatrix <https://www.wikidata.org/entity/Q3409269> ;
    iop:hasProperty <https://www.wikidata.org/entity/Q1738991> ;
    iop:hasConstraint 
        [ a iop:Constraint ;
            rdfs:isDefinedBy "event" ;
            rdfs:label "flood" ;
            iop:constrains <https://www.wikidata.org/entity/Q2288778> ;
        ] ,
        [ a iop:Constraint ;
            rdfs:isDefinedBy "scope" ;
            rdfs:label "grouping of homogeneous neighboring building blocks" ;
            iop:constrains <https://www.wikidata.org/entity/Q3409269> ;
        ] ,
        [ a iop:Constraint ;
            rdfs:isDefinedBy "condition" ;
            rdfs:label "mobility" ;
            iop:constrains <https://www.wikidata.org/entity/Q2288778> ;
        ] ,
        [ a iop:Constraint ;
            rdfs:isDefinedBy "feature" ;
            rdfs:label "accessibility" ;
            iop:constrains <https://www.wikidata.org/entity/Q2288778> ;
        ] .

<https://www.wikidata.org/entity/Q2288778>
    a iop:Entity ;
    rdfs:label "flood risk" .

<https://www.wikidata.org/entity/Q3409269>
    a iop:Entity ;
    rdfs:label "statistical unit" .

<https://www.wikidata.org/entity/Q1738991>
    a iop:Property ;
    rdfs:label "index" .
