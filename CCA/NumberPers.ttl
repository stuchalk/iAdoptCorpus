@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix ex: <http://example.org/iadopt/challenge/> .

ex:NumberPers
    a iop:Variable ;
    rdfs:label "Total Number of people living in a statistical unit" ;
    rdfs:comment "total number of people living within a statistical unit which is defined as a grouping of homogeneous neighboring building blocks" ;
    rdfs:comment "SJC: changed property to count**" ;
    iop:hasObjectOfInterest <https://www.wikidata.org/entity/Q22947> ;
    iop:hasMatrix <https://www.wikidata.org/entity/Q3409269> ;
    iop:hasProperty <https://qudt.org/vocab/quantitykind/Count> ;
    iop:hasConstraint 
        [ a iop:Constraint ;
            rdfs:isDefinedBy "scope" ;
            rdfs:label "grouping of homogeneous neighboring building blocks" ;
            iop:constrains <https://www.wikidata.org/entity/Q3409269> ;
        ] .

<https://www.wikidata.org/entity/Q22947>
    a iop:Entity ;
    rdfs:label "inhabitant" .

<https://www.wikidata.org/entity/Q3409269>
    a iop:Entity ;
    rdfs:label "statistical unit" .

<https://qudt.org/vocab/quantitykind/Count>
    a iop:Property ;
    rdfs:label "count" .