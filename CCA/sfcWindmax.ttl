@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix ex: <http://example.org/iadopt/> .

ex:sfcWindmax
    a iop:Variable ;
    rdfs:label "Daily Maximum Near-Surface Wind Speed of Gust" ;
    rdfs:comment "Daily Maximum Near-Surface Wind Speed of Gust, measured in m s^{-1}" ;
    skos:related "https://github.com/mabablue/I-ADOPT-examples-playground/issues/136" ;
    iop:hasObjectOfInterest <https://www.wikidata.org/entity/Q8094> ;
    iop:hasStatisticalModifier <https://www.wikidata.org/entity/Q10578722> ;
    iop:hasProperty <https://www.wikidata.org/entity/Q3711325> ;
    iop:hasConstraint 
        [ a iop:Constraint ;
            rdfs:isDefinedBy "location" ;
            rdfs:label "near surface" ;
            iop:constrains <https://www.wikidata.org/entity/Q8094> ;
        ] ,
        [ a iop:Constraint ;
            rdfs:isDefinedBy "transient event" ;
            rdfs:label "gust" ;
            iop:constrains <https://www.wikidata.org/entity/Q8094> ;
        ] ,
        [ a iop:Constraint ;
            rdfs:isDefinedBy "reporting frequency" ;
            rdfs:label "daily" ;
            iop:constrains <https://www.wikidata.org/entity/Q10578722> ;
        ] .

<https://www.wikidata.org/entity/Q8094>
    a iop:Entity ;
    rdfs:label "wind" .

<https://www.wikidata.org/entity/Q10578722>
    a iop:StatisticalModifier ;
    rdfs:label "maximum" .

<https://www.wikidata.org/entity/Q3711325>
    a iop:Property ;
    rdfs:label "speed" .
