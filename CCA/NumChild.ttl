@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix ex: <http://example.org/iadopt/> .

ex:NumChild
    a iop:Variable ;
    rdfs:label "Number of children under the age of 10 years in a statistical unit" ;
    rdfs:comment "number of children under the age of 10 years in a statistical unit which is defined as a grouping of homogeneous neighboring building blocks" ;
    skos:related "https://github.com/mabablue/I-ADOPT-examples-playground/issues/91" ;
    iop:hasObjectOfInterest <https://www.wikidata.org/entity/Q215627> ;
    iop:hasMatrix <https://www.wikidata.org/wiki/Q3409269> ;
    iop:hasProperty <http://qudt.org/vocab/quantitykind/Count> ;
    iop:hasConstraint 
        [ a iop:Constraint ;
            rdfs:isDefinedBy "condition" ;
            rdfs:label "age < 10 years" ;
            iop:constrains <https://www.wikidata.org/entity/Q215627> ;
        ] ,
        [ a iop:Constraint ;
            rdfs:isDefinedBy "scope" ;
            rdfs:label "grouping of homogeneous neighboring building blocks" ;
            iop:constrains <https://www.wikidata.org/wiki/Q3409269> ;
        ] .

<https://www.wikidata.org/entity/Q215627>
    a iop:Entity ;
    rdfs:label "person" .

<https://www.wikidata.org/wiki/Q3409269>
    a iop:Entity ;
    rdfs:label "statistical unit" .

<http://qudt.org/vocab/quantitykind/Count>
    a iop:Property ;
    rdfs:label "count" .
