@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix ex: <http://example.org/iadopt/> .

ex:PercentChild
    a iop:Variable ;
    rdfs:label "Percentage of number of children" ;
    rdfs:comment "Percentage of number of children under 10 years versus total number of people dwelling in the buildings within a statistical unit which is defined as a grouping of homogeneous neighboring building blocks" ;
    rdfs:comment "SJC: changed property to 'occupancy' which can be represented as a percentage**" ;
    iop:hasObjectOfInterest iop:AsymmetricSystem ;
    iop:hasMatrix <https://www.wikidata.org/entity/Q3409269> ;
    iop:hasProperty <https://www.wikidata.org/wiki/Q7075743> ;
    iop:hasConstraint 
        [ a iop:Constraint ;
            rdfs:isDefinedBy "scope" ;
            rdfs:label "grouping of homogeneous neighboring building blocks" ;
            iop:constrains <https://www.wikidata.org/entity/Q3409269> ;
        ] ,
        [ a iop:Constraint ;
            rdfs:isDefinedBy "condition" ;
            rdfs:label "age < 10 years" ;
            iop:constrains <https://www.wikidata.org/entity/Q7569> ;
        ] ,
        [ a iop:Constraint ;
            rdfs:isDefinedBy "demographics" ;
            rdfs:label "dwelling in the buildings within the statistical unit" ;
            iop:constrains iop:AsymmetricSystem ;
        ] .

iop:AsymmetricSystem
    a iop:Entity ;
    iop:hasDenominator <https://www.wikidata.org/entity/Q215627> ;
    iop:hasNumerator <https://www.wikidata.org/entity/Q7569> .

<https://www.wikidata.org/entity/Q3409269>
    a iop:Entity ;
    rdfs:label "statistical unit" .

<https://www.wikidata.org/wiki/Q7075743>
    a iop:Property ;
    rdfs:label "percentage" .

<https://www.wikidata.org/entity/Q215627>
    a iop:Entity ;
    rdfs:label "person" .

<https://www.wikidata.org/entity/Q7569>
    a iop:Entity ;
    rdfs:label "child" .
