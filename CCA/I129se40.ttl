@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix ex: <http://example.org/iadopt/challenge/> .

<http://example.org/CCA/I129se40>
    a iop:Variable ;
    rdfs:label "I129 deposition from Ringhals of Sweden" ;
    skos:definition "I129 deposition from Ringhals of Sweden (I129se40) in atoms kg-1" ;
    rdfs:comment "origin: Ringhals nuclear plant, condition: deposited, atoms per mass, Iodine-129, soil";
    rdfs:comment "SJC: change propoerty to number density per unit mass**" ;
    skos:related "https://github.com/mabablue/I-ADOPT-examples-playground/issues/135";
    iop:hasObjectOfInterest iop:AsymmetricSystem ;
    iop:hasProperty <https://www.wikidata.org/wiki/Q139568528> ;
    iop:hasConstraint 
        [ a iop:Constraint ;
            rdfs:isDefinedBy "source" ;
            rdfs:label "Ringhals nuclear plant" ;
            iop:constrains iop:AsymmetricSystem ;
        ] ,
        [ a iop:Constraint ;
            rdfs:isDefinedBy "process" ;
            rdfs:label "deposition" ;
            iop:constrains <https://www.wikidata.org/entity/Q2515411> ;
        ] .

iop:AsymmetricSystem
    a iop:Entity ;
    iop:hasNumerator <https://www.wikidata.org/entity/Q2515411> ;
    iop:hasDenominator <https://www.wikidata.org/entity/Q36133> .

<https://www.wikidata.org/wiki/Q139568528>
    a iop:Property ;
    rdfs:label "number density per unit mass" .

<https://www.wikidata.org/entity/Q2515411>
    a iop:Entity ;
    rdfs:label "Iodine-129" .

<https://www.wikidata.org/entity/Q36133>
    a iop:Entity ;
    rdfs:label "soil" .
