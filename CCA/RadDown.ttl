@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix ex: <http://example.org/iadopt/> .

ex:RadDown
    a iop:Variable ;
    rdfs:label "Surface long-wave (thermal) radiation downwards" ;
    skos:definition "Surface long-wave (thermal) radiation downwards measured in W m^{-2}" ;
    rdfs:comment "Surface-> location: at the surface; long-wave; radiation; downwards; measured in W m^{-2} -> energy flux; ADD: study area; ground; atmosphere" ;
    skos:related "https://github.com/mabablue/I-ADOPT-examples-playground/issues/109" ;
    iop:hasObjectOfInterest <https://www.wikidata.org/entity/Q18335> ;
    iop:hasMatrix iop:AsymmetricSystem ;
    iop:hasProperty <https://www.wikidata.org/entity/Q98538612> ;
    iop:hasConstraint 
        [ a iop:Constraint ;
            rdfs:isDefinedBy "spectral region" ;
            rdfs:label "infrared (long-wave)" ;
            iop:constrains <https://www.wikidata.org/entity/Q18335> ;
        ] ,
        [ a iop:Constraint ;
            rdfs:isDefinedBy "direction" ;
            rdfs:label "downwards" ;
            iop:constrains <https://www.wikidata.org/entity/Q18335> ;
        ] ,
        [ a iop:Constraint ;
            rdfs:isDefinedBy "part" ;
            rdfs:label "surface" ;
            iop:constrains <https://www.wikidata.org/entity/Q6501125> ;
        ] .

<https://www.wikidata.org/entity/Q18335>
    a iop:Entity ;
    rdfs:label "radiation" .

iop:AsymmetricSystem
    a iop:Entity ;
    iop:hasSource <https://www.wikidata.org/entity/Q8104> ;
    iop:hasTarget <https://www.wikidata.org/entity/Q6501125> .

<https://www.wikidata.org/entity/Q98538612>
    a iop:Property ;
    rdfs:label "energy fluence" .

<https://www.wikidata.org/entity/Q8104>
    a iop:Entity ;
    rdfs:label "atmosphere" .

<https://www.wikidata.org/entity/Q6501125>
    a iop:Entity ;
    rdfs:label "ground" .
