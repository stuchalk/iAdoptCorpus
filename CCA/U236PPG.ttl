@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix ex: <http://example.org/iadopt/> .

ex:U236PPG
    a iop:Variable ;
    rdfs:label "Point sources of U-236 from Pacific Proving Grounds " ;
    skos:definition "Point sources of U-236 from Pacific Proving Grounds (U236PPG) in atoms kg-1" ;
    rdfs:comment "Point sources of U-236 from Pacific Proving Grounds (U236PPG) in atoms kg-1" ;
    rdfs:comment "SJC: change property to number density per unit mass**" ;
    skos:related "https://github.com/mabablue/I-ADOPT-examples-playground/issues/133" ;
    iop:hasObjectOfInterest iop:AsymmetricSystem ;
    iop:hasProperty <https://www.wikidata.org/wiki/Q139568528> ;
    iop:hasConstraint 
        [ a iop:Constraint ;
            rdfs:isDefinedBy "source" ;
            rdfs:label "Pacific Proving Grounds" ;
            iop:constrains iop:AsymmetricSystem ;
        ] .

iop:AsymmetricSystem
    a iop:Entity ;
    iop:hasDenominator <https://www.wikidata.org/entity/Q36133> ;
    iop:hasNumerator <https://www.wikidata.org/entity/Q5955496> .

<https://www.wikidata.org/wiki/Q139568528>
    a iop:Property ;
    rdfs:label "number density per unit mass" .

<https://www.wikidata.org/entity/Q36133>
    a iop:Entity ;
    rdfs:label "soil" .

<https://www.wikidata.org/entity/Q5955496>
    a iop:Entity ;
    rdfs:label "Uranium 236" .
