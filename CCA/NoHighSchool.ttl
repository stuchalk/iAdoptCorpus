@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix ex: <http://example.org/iadopt/challenge/> .

ex:NoHighSchool
    a iop:Variable ;
    rdfs:label "Average number of persons without high school diploma during the last three years within a statistical unit" ;
    rdfs:comment "Average number of persons without a high school diploma during the last three years in a statistical unit, defined as a grouping of homogeneous neighboring building blocks" ;
    rdfs:comment "SJC: separated educational level and timeframe in constraints**" ;
    iop:hasObjectOfInterest <https://www.wikidata.org/entity/Q215627> ;
    iop:hasMatrix <https://www.wikidata.org/entity/Q3409269> ;
    iop:hasStatisticalModifier <https://www.wikidata.org/wiki/Q19033> ;
    iop:hasProperty <https://qudt.org/vocab/quantitykind/Count> ;
    iop:hasConstraint 
        [ a iop:Constraint ;
            rdfs:isDefinedBy "education" ;
            rdfs:label "no high school diploma" ;
            iop:constrains <https://www.wikidata.org/entity/Q215627> ;
        ] ,
        [ a iop:Constraint ;
            rdfs:isDefinedBy "temporal extent" ;
            rdfs:label "time: previous three years" ;
            iop:constrains <https://www.wikidata.org/entity/Q215627> ;
        ] ,
        [ a iop:Constraint ;
            rdfs:isDefinedBy "scope" ;
            rdfs:label "grouping of homogeneous neighboring building blocks" ;
            iop:constrains <https://www.wikidata.org/entity/Q3409269> ;
        ] .

<https://www.wikidata.org/entity/Q215627>
    a iop:Entity ;
    rdfs:label "person" .

<https://www.wikidata.org/entity/Q3409269>
    a iop:Entity ;
    rdfs:label "statistical unit" .

<https://www.wikidata.org/wiki/Q19033>
    a iop:StatisticalModifier ;
    rdfs:label "arithmetic mean" .

<https://qudt.org/vocab/quantitykind/Count>
    a iop:Property ;
    rdfs:label "count" .
