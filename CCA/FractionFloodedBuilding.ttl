@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix ex: <http://example.org/iadopt/> .

ex:FractionFloodedBuilding
    a iop:Variable ;
    rdfs:label "Fraction of flooded area around building" ;
    rdfs:comment "Fraction of flooded area above 30 cm water level within a 5 m buffer around an affected building" ;
    skos:related "https://github.com/mabablue/I-ADOPT-examples-playground/issues/90" ;
    iop:hasObjectOfInterest iop:AsymmetricSystem ;
    iop:hasProperty <http://www.ontology-of-units-of-measure.org/resource/om-2/AreaFraction> ;
    iop:hasConstraint 
        [ a iop:Constraint ;
            rdfs:isDefinedBy "condition" ;
            rdfs:label "water level: > 30 cm above ground" ;
            iop:constrains <https://www.wikidata.org/wiki/Q8068> ;
        ] ,
        [ a iop:Constraint ;
            rdfs:isDefinedBy "spatial extent" ;
            rdfs:label "area of 5 m around an affected building" ;
            iop:constrains <https://www.wikidata.org/wiki/Q3257686> ;
        ] .

iop:AsymmetricSystem
    a iop:Entity ;
    iop:hasNumerator <https://www.wikidata.org/wiki/Q8068> ;
    iop:hasDenominator <https://www.wikidata.org/wiki/Q3257686> .

<http://www.ontology-of-units-of-measure.org/resource/om-2/AreaFraction>
    a iop:Property ;
    rdfs:label "area fraction" .

<https://www.wikidata.org/wiki/Q8068>
    a iop:Entity ;
    rdfs:label "flood" .

<https://www.wikidata.org/wiki/Q3257686>
    a iop:Entity ;
    rdfs:label "locality" .
