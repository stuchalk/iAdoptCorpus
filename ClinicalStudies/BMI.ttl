@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix ex: <http://example.org/iadopt/> .

ex:BMI
    a iop:Variable ;
    rdfs:label "Body Mass Index" ;
    skos:definition "Body mass index calculated by dividing body mass by height squared" ;
    rdfs:comment "Body mass; index; defined by: body mass divided by height squared; ADD: person" ;
    rdfs:comment "SJC: this is a derived health metric; the property is BMI and is derived by making separate weight and height measurement" ;
    skos:related "https://github.com/mabablue/I-ADOPT-examples-playground/issues/107" ;
    iop:hasObjectOfInterest <https://www.wikidata.org/entity/Q5> ;
    iop:hasProperty <https://www.wikidata.org/wiki/Q131191> .

<https://www.wikidata.org/entity/Q5>
    a iop:Entity ;
    rdfs:label "person" .

<https://www.wikidata.org/wiki/Q131191>
    a iop:Property ;
    rdfs:label "body mass index" .
