@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix ex: <http://example.org/iadopt/> .

ex:C22
    a iop:Variable ;
    rdfs:label "Current smoking status" ;
    skos:definition "Smoking status current of a patient" ;
    rdfs:comment "patient; smoking status;  time: current" ;
    rdfs:comment "SJC: SNOMED CT entry is 'Tobacco user'" ;
    skos:related "https://github.com/mabablue/I-ADOPT-examples-playground/issues/28" ;
    iop:hasObjectOfInterest <https://www.wikidata.org/entity/Q5> ;
    iop:hasProperty <http://purl.bioontology.org/ontology/SNOMEDCT/110483000> ;
    iop:hasConstraint 
        [ a iop:Constraint ;
            rdfs:isDefinedBy "temporal state";
            rdfs:label "current" ;
            iop:constrains <http://purl.bioontology.org/ontology/SNOMEDCT/110483000> ;
        ] ,
        [ a iop:Constraint ;
            rdfs:isDefinedBy "role";
            rdfs:label "patient" ;
            iop:constrains <https://www.wikidata.org/entity/Q5> ;
        ] .

<https://www.wikidata.org/entity/Q5>
    a iop:Entity ;
    rdfs:label "person" .

<http://purl.bioontology.org/ontology/SNOMEDCT/110483000>
    a iop:Property ;
    rdfs:label "smoking status" .
