@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix ex: <http://example.org/iadopt/challenge/> .

ex:C16
    a iop:Variable ;
    rdfs:label "Standard metabolic rate in mg of oxygen per hour" ;
    skos:definition "The measure of an ectotherm animal's baseline metabolic rate (i.e. non-active, non-stressed) measured by the milligrams of oxygen consumed in a period of time of one hour." ;
    rdfs:comment "The measure of an ectotherm animal's baseline metabolic rate (i.e. non-active, non-stressed) measured by the milligrams of oxygen consumed in a period of time of one hour." ;
    skos:related "https://github.com/mabablue/I-ADOPT-examples-playground/issues/22" ;
    iop:hasObjectOfInterest <https://www.wikidata.org/entity/Q5203615> ;
    iop:hasMatrix iop:AsymmetricSystem ;
    iop:hasProperty <https://www.wikidata.org/entity/Q1366187> ;
    iop:hasConstraint 
        [ a iop:Constraint ;
            rdfs:isDefinedBy "type" ;
            rdfs:label "ectotherm" ;
            iop:constrains <https://www.wikidata.org/entity/Q7239> ;
        ] ,
        [ a iop:Constraint ;
            rdfs:isDefinedBy "condition" ;
            rdfs:label "non-stressed" ;
            iop:constrains <https://www.wikidata.org/entity/Q7239> ;
        ] ,
        [ a iop:Constraint ;
            rdfs:isDefinedBy "condition" ;
            rdfs:label "non-active" ;
            iop:constrains <https://www.wikidata.org/entity/Q7239> ;
        ] ,
        [ a iop:Constraint ;
            rdfs:isDefinedBy "process" ;
            rdfs:label "metabolism" ;
            iop:constrains iop:AsymmetricSystem ;
        ] ,
        [ a iop:Constraint ;
            rdfs:isDefinedBy "condition" ;
            rdfs:label "time: one hour" ;
            iop:constrains <https://www.wikidata.org/entity/Q1366187> ;
] .

