@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix ex: <http://example.org/iadopt/> .


ex:C21
    a iop:Variable ;
    rdfs:label "Resting systolic blood pressure" ;
    skos:definition "Resting systolic blood pressure in millimeters of mercury (mmHg)" ;
    rdfs:comment "blood; human; condition: resting; pressure; state: systolic" ;
    rdfs:comment "SJC: changed property to 'systolic pressure' as more specific" ;
    skos:related "https://github.com/mabablue/I-ADOPT-examples-playground/issues/27" ;
    iop:hasObjectOfInterest <https://www.wikidata.org/entity/Q7873> ;
    iop:hasMatrix <https://www.wikidata.org/entity/Q5> ;
    iop:hasProperty <https://www.wikidata.org/wiki/Q42015775> ;
    iop:hasConstraint 
        [ a iop:Constraint ;
            rdfs:isDefinedBy "locomotion state" ;
            rdfs:label "resting" ;
            iop:constrains <https://www.wikidata.org/entity/Q5> ;
        ] .

<https://www.wikidata.org/entity/Q7873>
    a iop:Entity ;
    rdfs:label "blood" .

<https://www.wikidata.org/entity/Q5>
    a iop:Entity ;
    rdfs:label "person" .

<https://www.wikidata.org/wiki/Q42015775>
    a iop:Property ;
    rdfs:label "systolic pressure" .
