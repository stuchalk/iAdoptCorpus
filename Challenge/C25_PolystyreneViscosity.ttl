    iop:hasProperty <https://www.wikidata.org/entity/Q15152757> ;
    iop:hasConstraint 
        [ a iop:Constraint ;
            rdfs:isDefinedBy "standard procedure" ;
            rdfs:label "DIN 5810-1" ;
            iop:constrains <https://www.wikidata.org/entity/Q15152757> ;
        ],
        [ a iop:Constraint ;
            rdfs:isDefinedBy "type" ;
            rdfs:label "PS042" ;
            iop:constrains <https://www.wikidata.org/wiki/Q146243> ;
        ].

