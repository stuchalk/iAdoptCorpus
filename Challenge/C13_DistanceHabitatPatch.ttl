@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix ex: <http://example.org/iadopt/> .

ex:C13
    a iop:Variable ;
    rdfs:label "Distance to nearest neighbour habitat patch" ;
    skos:definition "Distance to nearest neighbour habitat patch to measure the degree of connection of EUNIS habitats within a landscape." ;
    rdf:subject "https://github.com/EuropaBON/EBV-Descriptions/entity/Terrestrial-Connectivity-of-terrestrial-ecosystem-habitat-types" ;
    rdfs:comment "habitat patch system, distance, habitat patch, habitat patch, nearest neighbour -> location: nearest neighbour, ADD: type: specfic EUNIS habitat, landscape region, minimum" ;
    skos:related "https://github.com/mabablue/I-ADOPT-examples-playground/issues/19" ;
    iop:hasObjectOfInterest iop:AsymmetricSystem ;
    iop:hasMatrix <https://www.wikidata.org/entity/Q25496956> ;
    iop:hasStatisticalModifier <https://www.wikidata.org/entity/Q10585806> ;
    iop:hasProperty <https://www.wikidata.org/entity/Q126017> ;
    iop:hasConstraint 
        [ a iop:Constraint ;
            rdfs:isDefinedBy "condition" ;
            rdfs:label "nearest" ;
            iop:constrains ex:sourcepatch ;
        ] ,
        [ a iop:Constraint ;
            rdfs:isDefinedBy "codelist" ;
            rdfs:label "EUNIS habitat type" ;
            iop:constrains ex:AsymmetricSystem ;
        ] .

iop:AsymmetricSystem
    a iop:Entity ;
    rdfs:label "habitat patch system" ;
    iop:hasSource ex:sourcepatch;
    iop:hasTarget ex:targetpatch .

<https://www.wikidata.org/entity/Q25496956>
    a iop:Entity ;
    rdfs:label "landscape region" .

<https://www.wikidata.org/entity/Q10585806>
    a iop:StatisticalModifier ;
    rdfs:label "minimum" .

<https://www.wikidata.org/entity/Q126017>
    a iop:Property ;
    rdfs:label "distance" .

ex:sourcepatch
    a iop:Entity ;
    rdfs:label "habitat patch" .

ex:targetpatch
    a iop:Entity ;
    rdfs:label "habitat patch" .
