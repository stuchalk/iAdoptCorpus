@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix ex: <http://example.org/iadopt/> .

ex:C8
    a iop:Variable ;
    rdfs:label "Coarse woody debris abundance" ;
    rdfs:comment "Coarse woody debris (CWD) abundance per hectare measured from all the plots scaled to a hectare (m2/hectare)." ;
    skos:related "https://github.com/mabablue/I-ADOPT-examples-playground/issues/14" ;
    iop:hasObjectOfInterest iop:AsymmetricSystem ;
    iop:hasProperty <http://www.ontology-of-units-of-measure.org/resource/om-2/AreaFraction> ;
    iop:hasConstraint 
        [ a iop:Constraint ;
            rdfs:isDefinedBy "normalization" ;
            rdfs:label "per hectare" ;
            iop:constrains <https://www.wikidata.org/entity/Q36133> ;
        ] .

iop:AsymmetricSystem
    a iop:Entity ;
    iop:hasNumerator <https://www.wikidata.org/entity/Q2069734> ;
    iop:hasDenominator <https://www.wikidata.org/entity/Q36133> .

<http://www.ontology-of-units-of-measure.org/resource/om-2/AreaFraction>
    a iop:Property ;
    rdfs:label "area fraction" .

<https://www.wikidata.org/entity/Q2069734>
    a iop:Entity ;
    rdfs:label "coarse woody debris" .

<https://www.wikidata.org/entity/Q36133>
    a iop:Entity ;
    rdfs:label "ground" .
