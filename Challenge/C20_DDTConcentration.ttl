@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix ex: <http://example.org/iadopt/> .

ex:C20
    a iop:Variable ;
    rdfs:label "Concentration of DDT impacted by industry" ;
    rdfs:comment "Concentration of DDT in a given year at a site impacted by industry, measured in ng/g." ;
    rdfs:comment "SJC: property changed to mass fraction**" ;
    skos:related "https://github.com/mabablue/I-ADOPT-examples-playground/issues/26" ;
    iop:hasObjectOfInterest iop:AsymmetricSystem ;
    iop:hasProperty <https://www.wikidata.org/wiki/Q899138> ;
    iop:hasConstraint 
        [ a iop:Constraint ;
            rdfs:isDefinedBy "source" ;
            rdfs:label "industry" ;
            iop:constrains <https://www.wikidata.org/entity/Q163648> ;
        ] .

iop:AsymmetricSystem
    a iop:Entity ;
    iop:hasNumerator <https://www.wikidata.org/entity/Q163648> ;
    iop:hasDenominator <https://www.wikidata.org/entity/Q36133> .

<https://www.wikidata.org/wiki/Q899138>
    a iop:Property ;
    rdfs:label "mass fraction" .

<https://www.wikidata.org/entity/Q163648>
    a iop:Entity ;
    rdfs:label "DDT" .

<https://www.wikidata.org/entity/Q36133>
    a iop:Entity ;
    rdfs:label "soil" .
