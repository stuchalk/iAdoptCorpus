@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix ex: <http://example.org/iadopt/> .
@prefix uom: <http://www.ontology-of-units-of-measure.org/resource/om-2/> .

ex:C23
    a iop:Variable ;
    rdfs:label "Cellular dose in vitro of nanomaterials (mass/cell)" ;
    skos:definition "the mass of nanomaterial internalised into the cell over the duration of the experiment, mass per cell" ;
    rdfs:comment "nanomaterial; location: intracellular; cell ; mass per cell; ADD: group of cells" ;
    skos:related "https://github.com/mabablue/I-ADOPT-examples-playground/issues/29" ;
    iop:hasObjectOfInterest iop:AsymmetricSystem ;
    iop:hasMatrix <https://www.wikidata.org/entity/Q20088819> ;
    iop:hasProperty <https://www.wikidata.org/wiki/Q11423> ;
    iop:hasConstraint 
        [ a iop:Constraint ;
            rdfs:isDefinedBy "location";
            rdfs:label "intracellular" ;
            iop:constrains iop:AsymmetricSystem ;
        ] ,
        [ a iop:Constraint ;
            rdfs:isDefinedBy "temporal extent";
            rdfs:label "experiment duration" ;
            iop:constrains <https://www.wikidata.org/wiki/Q11423> ;
        ] ,
        [ a iop:Constraint ;
            rdfs:isDefinedBy "normalization";
            rdfs:label "per cell" ;
            iop:constrains <https://www.wikidata.org/wiki/Q11423> ;
        ] .

iop:AsymmetricSystem
    a iop:Entity ;
    iop:hasNumerator <https://www.wikidata.org/entity/Q967847> ;
    iop:hasDenominator <https://www.wikidata.org/entity/Q7868> .

<https://www.wikidata.org/entity/Q20088819>
    a iop:Entity ;
    rdfs:label "group of cells" .

<https://www.wikidata.org/wiki/Q11423>
    a iop:Property ;
    rdfs:label "mass" .

<https://www.wikidata.org/entity/Q967847>
    a iop:Entity ;
    rdfs:label "nanomaterial" .

<https://www.wikidata.org/entity/Q7868>
    a iop:Entity ;
    rdfs:label "cell" .
