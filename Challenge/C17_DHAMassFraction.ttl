@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix ex: <http://example.org/iadopt/> .
@prefix uom: <http://www.ontology-of-units-of-measure.org/resource/om-2/> .

ex:C17
    a iop:Variable ;
    rdfs:label "Docosahexaenoic acid content per dry weight (DHA content/ C22:6 n-3 content)" ;
    rdfs:comment "The amount of docosahexaenoic acid relative to dry weight in an organism." ;
    rdfs:comment "SJC: changed property to mass fraction**" ;
    iop:hasObjectOfInterest iop:AsymmetricSystem ;
    iop:hasProperty <https://www.wikidata.org/wiki/Q899138> ;
    iop:hasConstraint 
        [ a iop:Constraint ;
            rdfs:isDefinedBy "physical state";
            rdfs:label "dry" ;
            iop:constrains <https://www.wikidata.org/entity/Q7239> ;
        ] .

ex:AsymmetricSystem
    a iop:Entity ;
    iop:hasNumerator <https://www.wikidata.org/entity/Q423345> ;
    iop:hasDenominator <https://www.wikidata.org/entity/Q7239> .

<https://www.wikidata.org/wiki/Q899138>
    a iop:Property ;
    rdfs:label "mass fraction" .

<https://www.wikidata.org/entity/Q423345>
    a iop:Entity ;
    rdfs:label "docosahexaenoic acid" .

<https://www.wikidata.org/entity/Q7239>
    a iop:Entity ;
    rdfs:label "organism" .
