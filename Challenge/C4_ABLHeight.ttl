@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix ex: <http://example.org/iadopt/> .

ex:C4
    a iop:Variable ;
    rdfs:label "Atmospheric boundary layer height defined by temperature inversion" ;
    skos:definition "Atmospheric boundary layer height defined by temperature inversion." ;
    rdfs:comment "Atmospheric boundary layer, height, temperature inversion (ADD atmosphere, above ground surface, defined by: temperature inversion)." ;
    skos:related "https://github.com/mabablue/I-ADOPT-examples-playground/issues/10" ;
    iop:hasObjectOfInterest <http://vocabs.lter-europe.net/EnvThes/21543> ;
    iop:hasMatrix <https://www.wikidata.org/entity/Q8104> ;
    iop:hasProperty <https://www.wikidata.org/entity/Q208826> ;
    iop:hasConstraint 
        [ a iop:Constraint ;
            rdfs:isDefinedBy "process" ;
            rdfs:label "temperature inversion" ;
            iop:constrains <http://vocabs.lter-europe.net/EnvThes/21543> ;
        ] ,
        [ a iop:Constraint ;
            rdfs:isDefinedBy "reference" ;
            rdfs:label "above ground" ;
            iop:constrains <https://www.wikidata.org/entity/Q208826> ;
        ] .

<http://vocabs.lter-europe.net/EnvThes/21543>
    a iop:Entity ;
    rdfs:label "atmospheric boundary layer" .

<https://www.wikidata.org/entity/Q8104>
    a iop:Entity ;
    rdfs:label "atmosphere" .

<https://www.wikidata.org/entity/Q208826>
    a iop:Property ;
    rdfs:label "height" .
