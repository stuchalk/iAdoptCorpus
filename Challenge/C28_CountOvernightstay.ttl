@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix ex: <http://example.org/iadopt/> .

ex:C28
    a iop:Variable ;
    rdfs:label "Overnight stays in three-star hotel near the sea shore" ;
    skos:definition "Number of nights in a three-star hotel near the sea shore" ;
    rdfs:comment "nights; hotel; number; location: near the sea shore; type: three star";
    skos:related "https://github.com/mabablue/I-ADOPT-examples-playground/issues/34" ;
    iop:hasObjectOfInterest <https://www.wikidata.org/entity/Q575> ;
    iop:hasMatrix <https://www.wikidata.org/entity/Q27686> ;
    iop:hasProperty <https://www.wikidata.org/wiki/Q614112> ;
    iop:hasConstraint 
        [ a iop:Constraint ;
            rdfs:isDefinedBy "relative location" ;
            rdfs:label "near the sea shore" ;
            iop:constrains <https://www.wikidata.org/entity/Q27686> ;
        ] ,
        [ a iop:Constraint ;
            rdfs:isDefinedBy "quality" ;
            rdfs:label "three star" ;
            iop:constrains <https://www.wikidata.org/entity/Q27686> ;
        ] .

<https://www.wikidata.org/entity/Q575>
    a iop:Entity ;
    rdfs:label "night" .

<https://www.wikidata.org/entity/Q27686>
    a iop:Entity ;
    rdfs:label "hotel" .

<https://www.wikidata.org/wiki/Q614112>
    a iop:Property ;
    rdfs:label "number of entities" .
