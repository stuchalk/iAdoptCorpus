@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix ex: <http://example.org/iadopt/challenge/> .

ex:C24
    a iop:Variable ;
    rdfs:label "dose of applied nanomaterial internalised by a specific cell (number per cell)" ;
    skos:definition "Number of particles internalised into the cell over the duration of the experiment" ;
    rdfs:comment "nanomaterial; cell; number per cell; location: intracellular, duration of the experiment; ADD: group of cells" ;
    skos:related "https://github.com/mabablue/I-ADOPT-examples-playground/issues/30" ;
    iop:hasObjectOfInterest iop:AsymmetricSystem ;
    iop:hasMatrix <https://www.wikidata.org/entity/Q20088819> ;
    iop:hasProperty <https://www.wikidata.org/wiki/Q614112> ;
    iop:hasConstraint 
        [ a iop:Constraint ;
            rdfs:isDefinedBy "location";
            rdfs:label "intracellular" ;
            iop:constrains iop:AsymmetricSystem ;
        ] ,
        [ a iop:Constraint ;
            rdfs:isDefinedBy "temporal extent";
            rdfs:label "experiment duration" ;
            iop:constrains <https://www.wikidata.org/wiki/Q614112> ;
        ]  ,
        [ a iop:Constraint ;
            rdfs:isDefinedBy "normalization";
            rdfs:label "per cell" ;
            iop:constrains <https://www.wikidata.org/wiki/Q614112> ;
        ],
        [ a iop:Constraint ;
            rdfs:isDefinedBy "physical form";
            rdfs:label "particle" ;
            iop:constrains <https://www.wikidata.org/entity/Q967847> ;
        ] .

iop:AsymmetricSystem
    a iop:Entity ;
    iop:hasNumerator <https://www.wikidata.org/entity/Q967847> ;
    iop:hasDenominator <https://www.wikidata.org/entity/Q7868> .

<https://www.wikidata.org/entity/Q20088819>
    a iop:Entity ;
    rdfs:label "group of cells" .

<https://www.wikidata.org/wiki/Q614112>
    a iop:Property ;
    rdfs:label "number of entities" .

<https://www.wikidata.org/entity/Q967847>
    a iop:Entity ;
    rdfs:label "nanomaterial" .

<https://www.wikidata.org/entity/Q7868>
    a iop:Entity ;
    rdfs:label "cell" .
