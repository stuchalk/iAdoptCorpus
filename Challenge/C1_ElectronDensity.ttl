@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix ex: <http://example.org/iadopt/challenge/> .
@prefix uom: <http://www.ontology-of-units-of-measure.org/resource/om-2/> .

ex:C1
    a iop:Variable ;
    rdfs:label "Electron density in the solar wind" ;
    rdfs:comment "Density (particle per cm3) of electrons measured in the Solar Wind." ;
    skos:related "https://github.com/mabablue/I-ADOPT-examples-playground/issues/7" ;
    iop:hasObjectOfInterest iop:AsymmetricSystem ;
    iop:hasProperty <https://www.wikidata.org/entity/Q108914962> .

iop:AsymmetricSystem
    a iop:Entity ;
    iop:hasNumerator <https://www.wikidata.org/entity/Q2225> ;
    iop:hasDenominator <https://www.wikidata.org/entity/Q79833> .

<https://www.wikidata.org/entity/Q108914962>
    a iop:Property ;
    rdfs:label "number density" .

<https://www.wikidata.org/entity/Q2225>
    a iop:Entity ;
    rdfs:label "electron" .

<https://www.wikidata.org/entity/Q79833>
    a iop:Entity ;
    rdfs:label "solar wind" .
