ex:C9
    a 
        iop:Variable ;
    rdfs:label 
        "Foliage projective cover in the lower canopy strata" ;
    rdfs:comment 
        """The proportion (percentage) of the ground area covered by foliage (or photosynthetic tissue) in the lower canopy strata.""" ;
    iop:hasObjectOfInterest 
        _:b0 ;
    iop:hasProperty 
        uom:AreaFraction ;
    iop:hasConstraint 
        [ a iop:Constraint ;
             rdfs:label "layer: lower canopy strata" ;
             iop:constrains <https://www.wikidata.org/entity/Q18250160> ;
        ] .

_:b0
    a 
        iop:Entity ,
        iop:AsymmetricSystem ;
    iop:hasDenominator 
        <https://www.wikidata.org/entity/Q112117182> ;
    iop:hasNumerator 
        <https://www.wikidata.org/entity/Q18250160> .

uom:AreaFraction
    a 
        iop:Property ;
    rdfs:label 
        "area fraction" .

<https://www.wikidata.org/entity/Q112117182>
    a 
        iop:Entity ;
    rdfs:label 
        "study area" .

