@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix ex: <https://example.org/data/> .

ex:State-of-pipe
    a iop:Variable ;
    rdfs:label "State of connection pipe" ;
    skos:definition "State (faulty, cracked, ... ) of pipe connection in plastic with a diametre of 30 cm." ;
    rdfs:comment "state, pipe connection; plastic, diametre of 30 cm" ;
    skos:related "https://github.com/mabablue/I-ADOPT-examples-playground/issues/1" ;
    iop:hasObjectOfInterest <https://www.wikidata.org/wiki/Q4308705> ;
    iop:hasProperty <https://www.wikidata.org/wiki/Q140911574> ;
    iop:hasConstraint 
        [ a iop:Constraint ;
            rdfs:isDefinedBy "material type" ;
            rdfs:label "plastic" ;
            iop:constrains <https://www.wikidata.org/wiki/Q4308705> ;
        ] ,
        [ a iop:Constraint ;
             rdfs:isDefinedBy "condition" ;
             rdfs:label "diameter of 30 cm" ;
             iop:constrains <https://www.wikidata.org/wiki/Q4308705> ;
        ] .

<https://www.wikidata.org/wiki/Q4308705>
    a iop:Entity ;
    rdfs:label "pipe coupling" .

<https://www.wikidata.org/wiki/Q140911574>
    a iop:Property ;
    rdfs:label "state of repair" .
