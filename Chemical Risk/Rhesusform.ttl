@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix ex: <http://example.org/iadopt/> .

ex:rhesusform
    a iop:Variable ;
    rdfs:label "Observation of Rhesusform in blood" ;
    skos:definition "Rhesusform in a blood sample" ;
    rdfs:comment "blood; patient; rhesusform" ;
    skos:related "https://github.com/mabablue/I-ADOPT-examples-playground/issues/118" ;
    iop:hasObjectOfInterest <https://www.wikidata.org/entity/Q7873> ;
    iop:hasMatrix <https://www.wikidata.org/entity/Q5> ;
    iop:hasProperty <https://www.wikidata.org/wiki/Q97372079> .

<https://www.wikidata.org/entity/Q7873>
    a iop:Entity ;
    rdfs:label "blood" .

<https://www.wikidata.org/entity/Q5>
    a iop:Entity ;
    rdfs:label "person" .

<https://www.wikidata.org/wiki/Q97372079>
    a iop:Property ;
    rdfs:label "rhesus factor" .
