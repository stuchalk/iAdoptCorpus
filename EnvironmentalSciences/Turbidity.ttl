@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix ex: <http://example.org/iadopt/> .

ex:Turbidity
    a iop:Variable ;
    rdfs:label "Water turbidity of stagnant surface water " ;
    skos:definition "Water turbidity of stagnant surface water";
    rdfs:comment "state: stagnant, type: surface, turbidity, water body, water" ;
    skos:related "https://github.com/mabablue/I-ADOPT-examples-playground/issues/132";
    iop:hasObjectOfInterest <https://www.wikidata.org/entity/Q283> ;
    iop:hasProperty <https://www.wikidata.org/entity/Q898574> ;
    iop:hasConstraint 
        [ a iop:Constraint ;
            rdfs:isDefinedBy "movement" ;
            rdfs:label "stagnant" ;
            iop:constrains <https://www.wikidata.org/entity/Q15324> ;
        ] ,
        [ a iop:Constraint ;
            rdfs:isDefinedBy "part" ;
            rdfs:label "surface" ;
            iop:constrains <https://www.wikidata.org/entity/Q283> ;
        ] .

<https://www.wikidata.org/entity/Q283>
    a iop:Entity ;
    rdfs:label "water" .

<https://www.wikidata.org/entity/Q898574>
    a iop:Property ;
    rdfs:label "turbidity" .
