@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix ex: <http://example.org/iadopt/> .

ex:PrecRate
    a iop:Variable ;
    rdfs:label "Daily maximum hourly precipitation rate" ;
    skos:definition "Daily maximum hourly precipitation rate, measured in kg m⁻² s⁻¹";
    rdfs:comment "frequency: hourly, frequency: daily, ground, atmosphere, mass flux, maximum, vegetation-soil system, water, ADD: origin: precipitation" ;
    rdfs:comment "SJC: I think that the property should thus be 'mass fluence' not 'surface density'**" ;
    skos:related "https://github.com/mabablue/I-ADOPT-examples-playground/issues/124";
    iop:hasObjectOfInterest <https://www.wikidata.org/entity/Q283> ;
    iop:hasMatrix iop:AsymmetricSystem ;
    iop:hasStatisticalModifier <https://www.wikidata.org/entity/Q10578722> ;
    iop:hasProperty <https://www.wikidata.org/wiki/Q1907514> ;
    iop:hasConstraint 
        [ a iop:Constraint ;
            rdfs:isDefinedBy "reporting frequency" ;
            rdfs:label ": daily" ;
            iop:constrains <https://www.wikidata.org/entity/Q10578722> ;
        ] ,
        [ a iop:Constraint ;
            rdfs:isDefinedBy "normalization" ;
            rdfs:label "hourly" ;
            iop:constrains <https://www.wikidata.org/entity/Q10578722> ;
        ] ,
        [ a iop:Constraint ;
            rdfs:isDefinedBy "process" ;
            rdfs:label "precipitation" ;
            iop:constrains <https://www.wikidata.org/entity/Q283> ;
        ] .

<https://www.wikidata.org/entity/Q283>
    a iop:Entity ;
    rdfs:label "water" .

iop:AsymmetricSystem
    a iop:Entity ;
    rdfs:label "vegetation-soil system" ;
    iop:hasTarget <https://www.wikidata.org/entity/Q36133> ;
    iop:hasSource <https://www.wikidata.org/entity/Q8104> .

<https://www.wikidata.org/entity/Q10578722>
    a iop:StatisticalModifier ;
    rdfs:label "maximum" .

<https://www.wikidata.org/wiki/Q1907514>
    a iop:Property ;
    rdfs:label "surface density" .

<https://www.wikidata.org/entity/Q36133>
    a iop:Entity ;
    rdfs:label "ground" .

<https://www.wikidata.org/entity/Q8104>
    a iop:Entity ;
    rdfs:label "atmosphere" .
